{
  "name": "dsh-fetch-image",
  "version": "1.0.0",
  "private": true,
  "description": "GET 一个 HTTP(S) 地址，并把响应中的图片直接返回给模型。",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/myLiLingyun/dsh-fetch-image.git"
  },
  "homepage": "https://github.com/myLiLingyun/dsh-fetch-image#readme",
  "bugs": {
    "url": "https://github.com/myLiLingyun/dsh-fetch-image/issues"
  }
}
